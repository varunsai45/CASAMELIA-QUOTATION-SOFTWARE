# Set in the API project's Vercel Environment Variables, Production scope only.
APP_ENV=production
DATABASE_URL=postgresql://username:password@your-pooled-host/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://username:password@your-direct-host/database?sslmode=require
ALLOWED_ORIGINS=https://your-casamelia-web.vercel.app
COOKIE_SECURE=true
SESSION_HOURS=8
# Cloud build performs migrations/imports. Safe to keep enabled on later builds.
CASA_INITIALIZE_DATABASE=true
# First initialization only; never use development passwords for hosting.
ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
SALES_PASSWORD=replace-with-a-different-password-of-at-least-12-characters
